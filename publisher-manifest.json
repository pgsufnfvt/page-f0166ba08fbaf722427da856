900);color:var(--slate-100)}\n  .faq .sec-head{border-bottom-color:rgba(255,255,255,.16)}\n  .faq .sec-head h2{color:#fff}\n  .faq .sec-head .no{color:var(--cyan)}\n  .faq-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0 56px}\n  .faq-item{padding:22px 0 24px;border-bottom:1px solid rgba(255,255,255,.13);display:grid;grid-template-columns:46px 1fr;gap:14px}\n  .faq-item .q-no{font-size:22px;font-weight:800;color:var(--cyan);font-variant-numeric:tabular-nums;line-height:1.3}\n  .faq-item h3{margin:0 0 6px;font-size:16.5px;color:#fff;line-height:1.45}\n  .faq-item p{margin:0;font-size:14.5px;color:var(--slate-300);line-height:1.72}\n\n  footer{background:var(--slate-900);border-top:1px solid rgba(255,255,255,.13);color:var(--slate-500);font-size:13px;padding:22px 0 30px}\n  footer .wrap{display:flex;flex-wrap:wrap;gap:10px 24px;align-items:center;justify-content:space-between}\n  footer a{color:var(--slate-300);border-bottom:none}\n  footer a:hover{color:#fff}\n\n  /* 手机适配 */\n  @media (max-width:860px){.hero-grid{grid-template-columns:1fr;padding:36px 0 30px;}\n    .hero-main{padding-right:0;border-right:none;border-bottom:1px solid var(--line);padding-bottom:28px;}\n    .hero-side{padding-left:0;padding-top:26px;}\n    .steps{grid-template-columns:1fr;gap:0;}\n    .plan{grid-template-columns:1fr;gap:16px;}\n    .plan-body ul{grid-template-columns:1fr;}\n    .plan-ghost{font-size:80px;}\n    .clients{grid-template-columns:1fr;gap:28px;}\n    .faq-list{grid-template-columns:1fr;gap:0;}\n    section{padding:40px 0;}\n    .step-num{font-size:70px;}}\n  @media (max-width:520px){\n    .hero-side{grid-template-columns:1fr 1fr}\n    .quote{font-size:17px}\n    .faq-item{grid-template-columns:38px 1fr;gap:10px}\n    .plan-ghost{font-size:64px}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumbs\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#plans\">订阅方案</a>\n      <span class=\"sep\">/</span>\n      <span class=\"now\">壹速云 · 订购前先读</span>\n    </nav>\n    <nav class=\"toc\" aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#start\"><span class=\"idx\">01</span>使用说明</a></li>\n        <li><a href=\"#plans\"><span class=\"idx\">02</span>订阅方案</a></li>\n        <li><a href=\"#clients\"><span class=\"idx\">03</span>客户端准备</a></li>\n        <li><a href=\"#faq\"><span class=\"idx\">04</span>常见问题</a></li>\n      </ul>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <div class=\"hero-main\">\n          <span class=\"kicker\">壹速云 · 订购指南</span>\n          <h1>壹速云\n            <span class=\"thin\">先弄懂用量，再谈方案</span>\n          </h1>\n          <p class=\"lede\">选订阅这件事，难的不是比较价格，而是先知道自己一个月要用多少、几台设备同时开着、看不看流媒体。下面按这个顺序把壹速云的三档方案摊开讲，你对着自己的实际情况勾一遍，答案基本就出来了。</p>\n        </div>\n        <div class=\"hero-side\">\n          <p class=\"quote\">“别急着看哪档便宜。先写下你每天在线几个小时、几台设备轮着用，再回头看价格表——那时候贵和便宜才有意义。”\n            壹速云 · 订购提示\n          </p>\n          <div class=\"fact\">\n            <b>3</b>\n            <span>档订阅，按月或按年</span>\n          </div>\n          <div class=\"fact\">\n            <b>100GB</b>\n            <span>入门档月度流量起点</span>\n          </div>\n          <div class=\"fact\">\n            <b>20</b>\n            <span>团队档同时在线设备上限</span>\n          </div>\n          <div class=\"fact\">\n            <b>按年付</b>\n            <span>约为月付十倍，省两个月</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"start\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>开始之前，先做四件事</h2>\n        <span class=\"no\">STEP 01 — 04</span>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"step-num\">01</span>\n          <h3>数一数你的设备</h3>\n          <p>手机、平板、笔记本、家里的电视盒子，凡是会同时开着的都算进去。壹速云各档位的“同时在线设备数”是按并行连接计算的，轮着用和同时用是两回事，这一点先想清楚。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">02</span>\n          <h3>估一个月的流量</h3>\n          <p>网页和文档几乎不占流量，高清视频才是大头。如果你每天有一到两小时看视频，从 100GB 起步比较稳妥；家里人多设备多，直接看 300GB 那档更省心。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">03</span>\n          <h3>确认你的使用场景</h3>\n          <p>只是查资料、收发邮件，基础线路就够；要追流媒体或对延迟敏感，就对照方案里的线路说明挑；团队共用、需要固定分工的，看团队档的定制路由与专属对接。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">04</span>\n          <h3>决定付费周期</h3>\n          <p>按年付在各档位上都等于十个单价，相当于多用两个月。不确定能不能长期用，先按月付一个月试试，觉得合适再续年付，不必一上来就压一整年。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档订阅，逐行看清差别</h2>\n        <span class=\"no\">PLANS</span>\n      </div>\n\n      <article class=\"plan\">\n        <div class=\"plan-name\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 <small>/ 月</small></div>\n          <span class=\"annual\">按年付 ¥150 / 年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <span class=\"plan-ghost\">01</span>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-name\">\n          <span class=\"badge\">多数人选这档</span>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35 <small>/ 月</small></div>\n          <span class=\"annual\">按年付 ¥350 / 年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线，游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n        <span class=\"plan-ghost\">02</span>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-name\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 <small>/ 月</small></div>\n          <span class=\"annual\">按年付 ¥850 / 年</span>\n        </div>\n        <div class=\"plan-body\">\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <span class=\"plan-ghost\">03</span>\n      </article>\n\n      <p class=\"note\">价格与权益以上方列表为准。月付与年付的差异只在周期长短，权益内容一致；若你需要发票或采购流程，请在订购前与对接人确认，具体以实际开通时提供的信息为准。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"clients\">\n        <div>\n          <h2>客户端：先装对，再谈快慢</h2>\n          <p>壹速云的使用方式是按平台选择对应的客户端，再用账户信息完成配置。我们不在本页提供下载按钮或安装包地址，因为不同系统、不同版本的适用情况会变化，装错版本带来的问题往往比配置本身更麻烦。</p>\n          <p>正确的顺序是：先确认你的设备系统版本，再通过订购后获得的渠道说明获取当前适用的客户端与配置步骤。下方列出的是准备阶段需要核对的事项，按顺序过一遍，能省掉大部分反复调试的时间。</p>\n        </div>\n        <ol class=\"client-list\">\n          <li><span class=\"n\">01</span><div><b>确认设备系统版本</b><span class=\"d\">老版本系统可能不支持当前客户端，先看系统信息再动手。</span></div></li>\n          <li><span class=\"n\">02</span><div><b>通过官方渠道获取客户端</b><span class=\"d\">订购后在账户说明中查看当前可用的客户端与对应平台。</span></div></li>\n          <li><span class=\"n\">03</span><div><b>准备账户信息</b><span class=\"d\">配置所需的账户与节点信息由你的订阅提供，请只通过自己的账户获取。</span></div></li>\n          <li><span class=\"n\">04</span><div><b>首次连接后查看状态</b><span class=\"d\">看客户端是否显示已连接，再做一次简单的网页访问测试。</span></div></li>\n          <li><span class=\"n\">05</span><div><b>按需切换线路</b><span class=\"d\">不同线路的表现会随时间变化，遇到不稳定先换线路再判断。</span></div></li>\n          <li><span class=\"n\">06</span><div><b>记录自己的用量</b><span class=\"d\">在账户页查看剩余流量，接近上限前决定是否调整档位。</span></div></li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <span class=\"no\">Q &amp; A</span>\n      </div>\n      <ol class=\"faq-list\">\n        <li class=\"faq-item\">\n          <span class=\"q-no\">01</span>\n          <div>\n            <h3>我该从哪一档开始？</h3>\n            <p>如果你只有一两台设备、主要用来查资料和偶尔看视频，基础版足够起步。设备数达到四五台、经常看流媒体，旗舰版更合适。团队共用、设备多且需要固定分工的，直接看团队版。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">02</span>\n          <div>\n            <h3>“同时在线设备数”是怎么算的？</h3>\n            <p>指的是同一时间保持连接的设备数量。手机和平板轮流用，通常不会同时占用名额；但如果笔记本和电视盒子一起开着，就都算在内。接近上限时，多出来的设备可能需要等别的设备断开。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">03</span>\n          <div>\n            <h3>流量用超了会怎样？</h3>\n            <p>各档位都是按月计量的流量额度。接近上限时建议先在账户页查看剩余量，再决定是等下一个周期，还是调整到更高一档。具体处理方式请以你订购时确认的条款为准。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">04</span>\n          <div>\n            <h3>按年付比按月付划算多少？</h3>\n            <p>三档的年付价格都等于月付单价的十倍，也就是花十个月的钱用十二个月。如果你已经连续使用了一段时间、确认适合自己的使用习惯，再考虑转年付比较稳妥。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">05</span>\n          <div>\n            <h3>为什么这一页没有下载链接？</h3>\n            <p>客户端会随版本和平台更新，写死在本页的地址很容易过期。更合适的方式是订购后从账户说明里获取当前适用的客户端与配置步骤，这样你拿到的是与你的订阅对应的版本。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">06</span>\n          <div>\n            <h3>连上了但网页打不开，先查什么？</h3>\n            <p>按顺序排查：客户端是否显示已连接、当前选的是哪条线路、尝试切换一条线路、再刷新页面。多数情况是线路状态变化导致的，换线路就能解决；如果依旧不通，带上时间与线路信息联系支持。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">07</span>\n          <div>\n            <h3>支持哪些付款方式？</h3>\n            <p>本页不展示支付渠道信息，因为它会随订购入口变化。请以下单页面实际显示的支付方式为准，不要依据第三方转述的渠道信息操作。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <span class=\"q-no\">08</span>\n          <div>\n            <h3>团队版里的“定制路由”指什么？</h3>\n            <p>面向需要按团队结构分配线路的使用方式。具体如何配置、需要提供哪些信息，建议在订购前与专属客户经理沟通确认，避免开通后再返工调整。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>壹速云 · 订购指南</span>\n    <span><a href=\"#start\">使用说明</a> · <a href=\"#plans\">订阅方案</a> · <a href=\"#clients\">客户端准备</a> · <a href=\"#faq\">常见问题</a></span>\n  </div>\n</footer>",
